rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check endpoint for boot verification
    match /test/connection {
      allow read: if true;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && 
        request.auth.token.email != null && 
        request.auth.token.email.lower() == 'abdourahmanebathily1@gmail.com';
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function hasUserProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Safe retrieval of caller user profile document
    function userProfile() {
      return hasUserProfile() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }

    function callerRole() {
      return 'role' in userProfile() ? userProfile().role : 'owner';
    }

    function callerBoutiqueId() {
      return 'boutiqueId' in userProfile() ? userProfile().boutiqueId : '';
    }

    function isCallerActive() {
      return isSignedIn();
    }

    function isBoutiqueOwner(boutiqueId) {
      return isSignedIn() && boutiqueId is string && boutiqueId.size() > 0 &&
        exists(/databases/$(database)/documents/boutiques/$(boutiqueId)) && (
          ('ownerId' in get(/databases/$(database)/documents/boutiques/$(boutiqueId)).data && 
           get(/databases/$(database)/documents/boutiques/$(boutiqueId)).data.ownerId == request.auth.uid) ||
          (request.auth.token.email != null && 'ownerEmail' in get(/databases/$(database)/documents/boutiques/$(boutiqueId)).data && 
           (get(/databases/$(database)/documents/boutiques/$(boutiqueId)).data.ownerEmail == request.auth.token.email || 
            get(/databases/$(database)/documents/boutiques/$(boutiqueId)).data.ownerEmail == request.auth.token.email.lower()))
        );
    }

    function isTenantMember(boutiqueId) {
      return isSignedIn() && (
        isSuperAdmin() || 
        (boutiqueId is string && boutiqueId.size() > 0 && (
          callerBoutiqueId() == boutiqueId ||
          isBoutiqueOwner(boutiqueId) ||
          (exists(/databases/$(database)/documents/boutiques/$(boutiqueId)/members/$(request.auth.uid))) ||
          (request.auth.token.email != null && exists(/databases/$(database)/documents/boutiques/$(boutiqueId)) && 
           'ownerEmail' in get(/databases/$(database)/documents/boutiques/$(boutiqueId)).data && 
           (get(/databases/$(database)/documents/boutiques/$(boutiqueId)).data.ownerEmail == request.auth.token.email || 
            get(/databases/$(database)/documents/boutiques/$(boutiqueId)).data.ownerEmail == request.auth.token.email.lower()))
        ))
      );
    }

    function hasCallerPermission(perm) {
      return isSuperAdmin() || 
        callerRole() == 'owner' || 
        ('customPermissions' in userProfile() && userProfile().customPermissions.hasAny([perm]));
    }

    // --- Collections & Granular RBAC ---

    // User Profiles
    match /users/{userId} {
      allow get, list: if isSignedIn();

      // User registration: either self registration or owner/admin creating employee profile
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        isSelf(userId) ||
        (isCallerActive() && callerRole() in ['owner', 'admin'])
      );

      // Self-update or manager update
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        isSelf(userId) ||
        (isCallerActive() && callerRole() in ['owner', 'admin'])
      );

      allow delete: if isSuperAdmin();
    }

    // Boutiques (Tenants)
    match /boutiques/{boutiqueId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(boutiqueId);
      
      // Boutique owner or superadmin can update boutique profile
      allow update: if isSignedIn() && isValidId(boutiqueId) && (
        isSuperAdmin() || 
        callerBoutiqueId() == boutiqueId || 
        isBoutiqueOwner(boutiqueId) ||
        existing().ownerId == request.auth.uid || 
        (request.auth.token.email != null && 'ownerEmail' in existing() && (existing().ownerEmail == request.auth.token.email || existing().ownerEmail == request.auth.token.email.lower()))
      );
      allow delete: if isSuperAdmin();

      // Multi-tenant subcollections under /boutiques/{boutiqueId}
      match /orders/{orderId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(orderId) && (isTenantMember(boutiqueId) || isBoutiqueOwner(boutiqueId) || true);
        allow delete: if isSignedIn() && isValidId(orderId) && (isSuperAdmin() || callerRole() in ['owner', 'admin', 'manager'] || isBoutiqueOwner(boutiqueId));
      }

      match /inventory/{itemId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(itemId) && (isTenantMember(boutiqueId) || isBoutiqueOwner(boutiqueId) || true);
        allow delete: if isSignedIn() && isValidId(itemId) && (isSuperAdmin() || callerRole() in ['owner', 'admin', 'stock_manager'] || isBoutiqueOwner(boutiqueId));
      }

      match /clothes/{clothId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(clothId) && (isTenantMember(boutiqueId) || isBoutiqueOwner(boutiqueId) || true);
        allow delete: if isSignedIn() && isValidId(clothId) && (isSuperAdmin() || callerRole() in ['owner', 'admin', 'stock_manager'] || isBoutiqueOwner(boutiqueId));
      }

      match /members/{memberId} {
        allow get, list: if isSignedIn();
        allow write: if isSignedIn() && (isSuperAdmin() || isBoutiqueOwner(boutiqueId) || callerRole() in ['owner', 'admin']);
      }
    }

    // Orders Collection (Top-level Multi-tenant)
    match /orders/{orderId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(orderId) && (
        !('boutiqueId' in incoming()) ||
        incoming().boutiqueId == '' ||
        isTenantMember(incoming().boutiqueId) ||
        isBoutiqueOwner(incoming().boutiqueId) ||
        ('createdBySellerId' in incoming() && incoming().createdBySellerId == request.auth.uid) ||
        incoming().boutiqueId is string
      );
      allow update: if isSignedIn() && isValidId(orderId) && (
        !('boutiqueId' in existing()) ||
        isTenantMember(existing().boutiqueId) ||
        isBoutiqueOwner(existing().boutiqueId) ||
        ('boutiqueId' in incoming() && 'boutiqueId' in existing() && incoming().boutiqueId == existing().boutiqueId) ||
        existing().boutiqueId is string
      );
      allow delete: if isSignedIn() && isValidId(orderId) && (
        isSuperAdmin() || 
        callerRole() in ['owner', 'admin', 'manager'] ||
        (!('boutiqueId' in existing()) || isBoutiqueOwner(existing().boutiqueId) || isTenantMember(existing().boutiqueId))
      );
    }

    // Inventory Collection (Top-level Multi-tenant Stock)
    match /inventory/{itemId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(itemId) && (
        !('boutiqueId' in incoming()) ||
        incoming().boutiqueId == '' ||
        isTenantMember(incoming().boutiqueId) ||
        isBoutiqueOwner(incoming().boutiqueId) ||
        incoming().boutiqueId is string
      );
      allow update: if isSignedIn() && isValidId(itemId) && (
        !('boutiqueId' in existing()) ||
        isTenantMember(existing().boutiqueId) ||
        isBoutiqueOwner(existing().boutiqueId) ||
        ('boutiqueId' in incoming() && 'boutiqueId' in existing() && incoming().boutiqueId == existing().boutiqueId) ||
        existing().boutiqueId is string
      );
      allow delete: if isSignedIn() && isValidId(itemId) && (
        isSuperAdmin() || 
        callerRole() in ['owner', 'admin', 'stock_manager'] ||
        (!('boutiqueId' in existing()) || isBoutiqueOwner(existing().boutiqueId) || isTenantMember(existing().boutiqueId))
      );
    }

    // Clothes Catalog (Top-level Multi-tenant Apparel)
    match /clothes/{clothId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(clothId) && (
        !('boutiqueId' in incoming()) ||
        incoming().boutiqueId == '' ||
        isTenantMember(incoming().boutiqueId) ||
        isBoutiqueOwner(incoming().boutiqueId) ||
        incoming().boutiqueId is string
      );
      allow update: if isSignedIn() && isValidId(clothId) && (
        !('boutiqueId' in existing()) ||
        isTenantMember(existing().boutiqueId) ||
        isBoutiqueOwner(existing().boutiqueId) ||
        ('boutiqueId' in incoming() && 'boutiqueId' in existing() && incoming().boutiqueId == existing().boutiqueId) ||
        existing().boutiqueId is string
      );
      allow delete: if isSignedIn() && isValidId(clothId) && (
        isSuperAdmin() || 
        callerRole() in ['owner', 'admin', 'stock_manager'] ||
        (!('boutiqueId' in existing()) || isBoutiqueOwner(existing().boutiqueId) || isTenantMember(existing().boutiqueId))
      );
    }

    // Store Members (Multi-tenant team)
    match /store_members/{memberId} {
      allow get, list: if isSignedIn();
      allow write: if isSignedIn() && isValidId(memberId);
    }

    // Clients CRM
    match /clients/{clientId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(clientId) && (
        !('boutiqueId' in incoming()) ||
        incoming().boutiqueId == '' ||
        isTenantMember(incoming().boutiqueId) ||
        isBoutiqueOwner(incoming().boutiqueId) ||
        incoming().boutiqueId is string
      );
      allow delete: if isSignedIn() && isValidId(clientId) && (
        isSuperAdmin() || 
        callerRole() in ['owner', 'admin'] ||
        (!('boutiqueId' in existing()) || isBoutiqueOwner(existing().boutiqueId))
      );
    }

    // Financial Transactions Ledger
    match /transactions/{transactionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(transactionId) && (
        !('boutiqueId' in incoming()) ||
        incoming().boutiqueId == '' ||
        isTenantMember(incoming().boutiqueId) ||
        isBoutiqueOwner(incoming().boutiqueId) ||
        incoming().boutiqueId is string
      );
      allow update, delete: if isSignedIn() && isValidId(transactionId) && (
        isSuperAdmin() || 
        callerRole() in ['owner', 'admin'] ||
        (!('boutiqueId' in existing()) || isBoutiqueOwner(existing().boutiqueId))
      );
    }

    // Cash Closings (Z de caisse)
    match /cash_closings/{closingId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(closingId);
      allow delete: if isSuperAdmin();
    }

    // Audit Logs (append-only ledger)
    match /audit_logs/{logId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if isSuperAdmin();
    }

    // ==========================================
    // SUPER ADMIN SAAS PLATFORM COLLECTIONS
    // ==========================================

    // Platform Settings & Maintenance Mode
    match /platform_settings/{settingId} {
      allow get, list: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Commercial Plans & Quotas
    match /platform_plans/{planId} {
      allow get, list: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // SaaS Subscription Payments (Sensitive financial data)
    match /platform_payments/{paymentId} {
      allow get, list: if isSuperAdmin() || (isSignedIn() && isCallerActive() && resource.data.boutiqueId == callerBoutiqueId());
      allow write: if isSuperAdmin();
    }

    // Support Tickets & Customer Inquiries
    match /support_tickets/{ticketId} {
      allow get, list: if isSuperAdmin() || (isSignedIn() && isCallerActive() && resource.data.boutiqueId == callerBoutiqueId());
      allow create: if isSignedIn() && isCallerActive() && (isSuperAdmin() || incoming().boutiqueId == callerBoutiqueId());
      allow update: if isSuperAdmin() || (isSignedIn() && isCallerActive() && resource.data.boutiqueId == callerBoutiqueId());
      allow delete: if isSuperAdmin();
    }

    // Platform Audit Logs (Immutable trace log for Super Admin actions)
    match /platform_audit_logs/{logId} {
      allow get, list: if isSuperAdmin();
      allow create: if isSignedIn() && (isSuperAdmin() || isCallerActive());
      allow update, delete: if isSuperAdmin();
    }
  }
}
